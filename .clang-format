---
# libarude code formatting.
#
# Requires clang-format 21 or newer. Pin the version in CI: older clang-format
# ignores keys it does not know silently instead of failing, so a contributor
# on an older build gets quietly different formatting rather than an error.
# Validated against clang-format 21.
# Option reference: https://clang.llvm.org/docs/ClangFormatStyleOptions.html
#
# Run `clang-format --dump-config --style=file` to see the fully resolved
# configuration, including every default this file does not mention.

Language: Cpp
BasedOnStyle: LLVM
Standard: Latest

# --- Line layout ---------------------------------------------------------
# 120 columns suits the descriptive names used here; two-space indents keep
# deeply nested templates from running into that limit.
ColumnLimit: 120
IndentWidth: 2
ContinuationIndentWidth: 2
TabWidth: 2
UseTab: Never
MaxEmptyLinesToKeep: 1
KeepEmptyLines:
  AtEndOfFile: false
  AtStartOfBlock: false
  AtStartOfFile: true
# DeriveLF: infer from the file, defaulting to LF. Keeps mixed-platform
# checkouts from churning line endings.
LineEnding: DeriveLF
InsertNewlineAtEOF: true

# --- Braces --------------------------------------------------------------
# Allman: every brace on its own line, except where noted below.
BreakBeforeBraces: Custom
BraceWrapping:
  AfterCaseLabel: true
  AfterClass: true
  AfterControlStatement: Always
  AfterEnum: true
  AfterFunction: true
  AfterNamespace: true
  AfterStruct: true
  AfterUnion: true
  AfterExternBlock: true
  BeforeCatch: true
  BeforeElse: true
  BeforeLambdaBody: true
  BeforeWhile: true
  IndentBraces: false
  SplitEmptyFunction: true
  SplitEmptyRecord: false
  SplitEmptyNamespace: true

# Collapse trivial bodies, but never an `if` — a one-line `if` is where the
# next edit silently introduces a bug.
AllowShortBlocksOnASingleLine: Always
AllowShortCaseLabelsOnASingleLine: true
AllowShortEnumsOnASingleLine: false
AllowShortFunctionsOnASingleLine: InlineOnly
AllowShortIfStatementsOnASingleLine: Never
AllowShortLambdasOnASingleLine: All
AllowShortLoopsOnASingleLine: false

# --- Indentation ---------------------------------------------------------
AccessModifierOffset: -2
EmptyLineAfterAccessModifier: Never
EmptyLineBeforeAccessModifier: Always
IndentAccessModifiers: false
IndentCaseBlocks: false
IndentCaseLabels: false
IndentExternBlock: NoIndent
IndentGotoLabels: true
IndentPPDirectives: BeforeHash
IndentWrappedFunctionNames: false
LambdaBodyIndentation: Signature
NamespaceIndentation: None
FixNamespaceComments: true
CompactNamespaces: false
ShortNamespaceLines: 0
# Blank line just inside every namespace brace, however short the body. Note
# a namespace whose body is only another namespace is left alone, so nested
# `namespace a { namespace b {` pairs get the blank lines on the inner one.
WrapNamespaceBodyWithEmptyLines: Always

# --- Alignment -----------------------------------------------------------
# Consecutive alignment is off by design: it makes an unrelated line reflow
# whenever the longest name in a group changes, which pollutes diffs.
AlignAfterOpenBracket: AlwaysBreak
AlignArrayOfStructures: Right
AlignConsecutiveAssignments: false
AlignConsecutiveBitFields: false
AlignConsecutiveDeclarations: false
AlignConsecutiveMacros: true
AlignEscapedNewlines: Right
AlignOperands: Align
AlignTrailingComments:
  Kind: Always
  OverEmptyLines: 0

# --- Breaking and packing ------------------------------------------------
# One argument per line once a call has to wrap, rather than filling lines.
# Adding or removing an argument then touches one line in the diff.
BinPackArguments: false
BinPackParameters: false
AllowAllArgumentsOnNextLine: true
AllowAllParametersOfDeclarationOnNextLine: true
PackConstructorInitializers: Never
ConstructorInitializerIndentWidth: 2
BreakConstructorInitializers: BeforeComma
BreakInheritanceList: BeforeComma
BreakBeforeBinaryOperators: None
BreakBeforeTernaryOperators: true
# When an expression must wrap, break at the loosest-binding operators and
# keep tighter ones on their line, so `a + b * c` breaks around the + first.
BreakBinaryOperations: RespectPrecedence
BreakBeforeConceptDeclarations: Always
BreakAfterReturnType: None
BreakTemplateDeclarations: Yes
AlwaysBreakBeforeMultilineStrings: false
BreakStringLiterals: true
SeparateDefinitionBlocks: Leave

# --- Spacing -------------------------------------------------------------
PointerAlignment: Left
ReferenceAlignment: Left
DerivePointerAlignment: false
Cpp11BracedListStyle: true
SpaceAfterCStyleCast: false
SpaceAfterLogicalNot: false
SpaceAfterTemplateKeyword: false
SpaceAroundPointerQualifiers: Before
SpaceBeforeAssignmentOperators: true
SpaceBeforeCaseColon: false
SpaceBeforeCpp11BracedList: false
SpaceBeforeCtorInitializerColon: true
SpaceBeforeInheritanceColon: true
SpaceBeforeRangeBasedForLoopColon: true
SpaceBeforeSquareBrackets: false
SpaceInEmptyBlock: false
SpacesBeforeTrailingComments: 1
SpacesInAngles: Never
SpacesInContainerLiterals: false
SpacesInSquareBrackets: false
SpaceBeforeParens: Custom
SpaceBeforeParensOptions:
  AfterControlStatements: false
  AfterForeachMacros: false
  AfterFunctionDeclarationName: false
  AfterFunctionDefinitionName: false
  AfterIfMacros: false
  AfterOverloadedOperator: false
  AfterRequiresInClause: false
  AfterRequiresInExpression: false
  BeforeNonEmptyParentheses: false
# Replaces the old SpacesInParentheses / SpacesInConditionalStatement /
# SpacesInCStyleCastParentheses / SpaceInEmptyParentheses quartet.
SpacesInParens: Never

# --- Includes ------------------------------------------------------------
# Priority 1 sorts own headers first, then third-party angle includes, then
# the standard library last. Preserve keeps existing blank-line groupings
# rather than merging everything into one block.
IncludeBlocks: Preserve
SortIncludes: CaseInsensitive
IncludeCategories:
  - Regex: '^"arude/'
    Priority: 1
  - Regex: '^<boost/'
    Priority: 2
  - Regex: '^<.*\.h(pp)?>'
    Priority: 3
  - Regex: '^<.*>'
    Priority: 4
  - Regex: '.*'
    Priority: 1
IncludeIsMainRegex: '(_test)?$'
SortUsingDeclarations: true

# --- C++20 concepts ------------------------------------------------------
IndentRequiresClause: true
RequiresClausePosition: OwnLine
RequiresExpressionIndentation: OuterScope
AllowShortCompoundRequirementOnASingleLine: true

# --- Comments ------------------------------------------------------------
# Was a bool until clang-format 20; Always is the modern spelling of `true`.
# Never and IndentOnly are the alternatives.
ReflowComments: Always
CommentPragmas: '^ IWYU pragma:'

# --- Source-modifying cleanups -------------------------------------------
# These rewrite code rather than just whitespace, so they are listed together.
# InsertBraces adds braces to single-statement control flow; enabling it is
# what makes AllowShortIfStatementsOnASingleLine: Never fully effective.
InsertBraces: true
RemoveSemicolon: true
# Strip trailing commas from enumerators, so an enum never carries one. Set
# to Leave to stop clang-format touching them, or Insert for the opposite
# policy (a trailing comma keeps "add an enumerator" to a one-line diff).
EnumTrailingComma: Remove
# Drop blank lines that sit inside a single statement, such as between the
# arguments of one call. Blank lines between statements are unaffected.
RemoveEmptyLinesInUnwrappedLines: true
RemoveParentheses: Leave
InsertTrailingCommas: None
# QualifierAlignment rewrites `const` placement and is documented as not
# always safe in the presence of macros. Left alone deliberately.
QualifierAlignment: Leave

# --- Penalties -----------------------------------------------------------
# Relative costs the line breaker minimises. Inherited unchanged; tune only
# with a concrete example that formats badly.
PenaltyBreakAssignment: 2
PenaltyBreakBeforeFirstCallParameter: 30
PenaltyBreakComment: 300
PenaltyBreakFirstLessLess: 120
PenaltyBreakOpenParenthesis: 60
PenaltyBreakString: 10000
PenaltyBreakTemplateDeclaration: 10
PenaltyExcessCharacter: 10000
PenaltyReturnTypeOnItsOwnLine: 60
